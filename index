    // --- Web Audio Setup ---
    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        masterGain = audioCtx.createGain();
        masterGain.gain.value = parseFloat(document.getElementById('master-vol').value);

        setupEffects();
        masterGain.connect(audioCtx.destination);
      }
      if (audioCtx.state === 'suspended') {
        audioCtx.resume();
      }
    }

    function setupEffects() {
      fxDistortion = audioCtx.createWaveShaper();
      updateDistortionCurve(0);

      fxChorusDelay = audioCtx.createDelay();
      fxChorusDelay.delayTime.value = 0.02;
      fxChorusLfo = audioCtx.createOscillator();
      const chorusLfoGain = audioCtx.createGain();
      chorusLfoGain.gain.value = 0.002;
      fxChorusLfo.frequency.value = 1.5;
      fxChorusLfo.connect(chorusLfoGain);
      chorusLfoGain.connect(fxChorusDelay.delayTime);
      fxChorusLfo.start();

      fxDelayL = audioCtx.createDelay();
      fxDelayR = audioCtx.createDelay();
      fxDelayFbGain = audioCtx.createGain();
      const merger = audioCtx.createChannelMerger(2);

      fxDelayL.delayTime.value = 0.3;
      fxDelayR.delayTime.value = 0.45;
      fxDelayFbGain.gain.value = 0.4;

      fxDelayL.connect(fxDelayFbGain);
      fxDelayFbGain.connect(fxDelayR);
      fxDelayR.connect(fxDelayL);

      fxDelayL.connect(merger, 0, 0);
      fxDelayR.connect(merger, 0, 1);

      fxReverbConvolver = audioCtx.createConvolver();
      updateReverbImpulse(2.0);

      fxDistortion.connect(masterGain);
      fxChorusDelay.connect(masterGain);
      merger.connect(masterGain);
      fxReverbConvolver.connect(masterGain);

      document.getElementById('fx-dist-drive').addEventListener('input', (e) => updateDistortionCurve(parseFloat(e.target.value)));
      document.getElementById('fx-chorus-rate').addEventListener('input', (e) => fxChorusLfo.frequency.value = parseFloat(e.target.value));
      document.getElementById('fx-delay-time').addEventListener('input', (e) => {
        const t = parseFloat(e.target.value);
        fxDelayL.delayTime.value = t;
        fxDelayR.delayTime.value = t * 1.5;
      });
      document.getElementById('fx-delay-fb').addEventListener('input', (e) => fxDelayFbGain.gain.value = parseFloat(e.target.value));
      document.getElementById('fx-verb-time').addEventListener('input', (e) => updateReverbImpulse(parseFloat(e.target.value)));
    }

    function updateDistortionCurve(drive) {
      if (!fxDistortion) return;
      const k = drive;
      const n_samples = 44100;
      const curve = new Float32Array(n_samples);
      const deg = Math.PI / 180;
      for (let i = 0; i < n_samples; ++i) {
        let x = (i * 2) / n_samples - 1;
        curve[i] = ((3 + k) * x * 20 * deg) / (Math.PI + k * Math.abs(x));
      }
      fxDistortion.curve = curve;
    }

    function updateReverbImpulse(duration) {
      if (!audioCtx || !fxReverbConvolver) return;
      const rate = audioCtx.sampleRate;
      const length = rate * duration;
      const impulse = audioCtx.createBuffer(2, length, rate);
      for (let channel = 0; channel < 2; channel++) {
        const data = impulse.getChannelData(channel);
        for (let i = 0; i < length; i++) {
          data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 2);
        }
      }
      fxReverbConvolver.buffer = impulse;
    }

    function createCustomWavetable(ctx, position) {
      const real = new Float32Array(64);
      const imag = new Float32Array(64);
      const pos = Math.max(0, Math.min(1, position));

      for (let n = 1; n < 64; n++) {
        let sineHarm = (n === 1) ? 1 : 0;
        let sqHarm   = (n % 2 !== 0) ? (4 / (Math.PI * n)) : 0;
        let triHarm  = (n % 2 !== 0) ? (8 / (Math.PI * Math.PI * n * n)) : 0;
        let sawHarm  = (2 / (Math.PI * n));

        let amp = 0;
        if (pos <= 0.33) {
          let t = pos / 0.33;
          amp = sineHarm * (1 - t) + sqHarm * t;
        } else if (pos <= 0.66) {
          let t = (pos - 0.33) / 0.33;
          amp = sqHarm * (1 - t) + triHarm * t;
        } else {
          let t = (pos - 0.66) / 0.34;
          amp = triHarm * (1 - t) + sawHarm * t;
        }
        imag[n] = amp;
      }
      return ctx.createPeriodicWave(real, imag);
    }

