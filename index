    document.getElementById('json-file-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (evt) => {
        try {
          const state = JSON.parse(evt.target.result);
          loadFullState(state);
        } catch (err) {
          alert("Invalid JSON File: " + err.message);
        }
      };
      reader.readAsText(file);
    });

    // --- Global Controls Event Bindings ---
    document.getElementById('btn-audio-init').addEventListener('click', () => {
      initAudio();
      document.getElementById('btn-audio-init').textContent = "🔊 Audio Active";
      document.getElementById('btn-audio-init').style.background = "#2ed573";
    });

    document.getElementById('btn-add-vco').addEventListener('click', () => addLayer());
    document.getElementById('btn-add-lfo').addEventListener('click', () => addLFO());

    document.getElementById('btn-play').addEventListener('click', (e) => {
      initAudio();
      isPlaying = !isPlaying;
      if (isPlaying) {
        e.target.textContent = "⏸ Pause";
        e.target.style.background = "#ff4757";
        currentStep = 0;
        totalElapsedSteps = 0;
        stepSequence();
      } else {
        e.target.textContent = "▶ Play";
        e.target.style.background = "var(--accent-color)";
        clearTimeout(seqTimer);
        document.querySelectorAll('.seq-step').forEach(el => el.classList.remove('playing'));
      }
    });

    document.getElementById('master-vol').addEventListener('input', (e) => {
      if (masterGain) masterGain.gain.value = parseFloat(e.target.value);
    });

    document.getElementById('master-bpm').addEventListener('input', (e) => {
      document.getElementById('bpm-val').textContent = e.target.value;
    });

    document.getElementById('master-transpose').addEventListener('input', (e) => {
      document.getElementById('transpose-val').textContent = e.target.value;
    });

    document.getElementById('chord-slider').addEventListener('input', (e) => {
      const idx = Math.round(parseFloat(e.target.value));
      document.getElementById('chord-name').textContent = CHORD_TABLE[idx].name;
    });

    document.getElementById('chord-rate-slider').addEventListener('input', (e) => {
      const idx = Math.round(parseFloat(e.target.value));
      document.getElementById('chord-rate-val').textContent = CHORD_CHANGE_RATES[idx].label.split(' ')[0];
    });

    // Initial Launch Setup
    addLFO(); // Default LFO 1
    addLayer(); // Default VCO Layer 1
    initCameraDevices();
  </script>
</body>
</html>
