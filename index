        ${lfoList.map(l => `<option value="lfo_${l.id}">LFO ${l.id}</option>`).join('')}
      `;
      select.value = currentVal;
    }

    function addLayer() {
      layerIdCounter++;
      const layer = new VCOLayer(layerIdCounter, document.getElementById('layers-container'));
      vcoLayers.push(layer);
      bindModulationEvents();
    }

    function removeLayer(id) {
      vcoLayers = vcoLayers.filter(l => l.id !== id);
      const elem = document.getElementById(`layer-${id}`);
      if (elem) elem.remove();
    }

    // --- Sequencer Engine ---
    function stepSequence() {
      if (!isPlaying) return;

      const now = audioCtx ? audioCtx.currentTime : 0;

      // 1. Calculate Modulated Chord Change Rate
      const rawRateVal = parseFloat(document.getElementById('chord-rate-slider').value);
      const moddedRateVal = getModulatedValue('chordRate', rawRateVal, 0, 4);
      const rateIdx = Math.max(0, Math.min(4, Math.round(moddedRateVal)));
      const rateObj = CHORD_CHANGE_RATES[rateIdx];

      document.getElementById('chord-rate-val').textContent = rateObj.label.split(' ')[0];

      // 2. Update Chord on timing intervals
      if (totalElapsedSteps % rateObj.steps === 0 || totalElapsedSteps === 0) {
        const rawChordVal = parseFloat(document.getElementById('chord-slider').value);
        const moddedChordVal = getModulatedValue('chordSlider', rawChordVal, 0, 8);
        let chordIdx = Math.max(0, Math.min(8, Math.round(moddedChordVal)));

        let chordObj = CHORD_TABLE[chordIdx];
        if (OVERRIDE_CHORDS[lastPlayedChordName]) {
          chordObj = OVERRIDE_CHORDS[lastPlayedChordName];
        }
        currentChordObj = chordObj;
        lastPlayedChordName = chordObj.name;
        document.getElementById('chord-name').textContent = chordObj.name;
      }

      document.querySelectorAll('.seq-step').forEach(el => el.classList.remove('playing'));

      // 3. Trigger VCO Layers
      vcoLayers.forEach(layer => {
        const step = layer.steps[currentStep];
        const stepEl = layer.element.querySelectorAll('.seq-step')[currentStep];
        if (stepEl) stepEl.classList.add('playing');

        if (step.active) {
          const notes = currentChordObj.notes;
          if (step.noteVal === 'all') {
            notes.forEach(midiNote => layer.playNote(midiNote, step.velocity, now));
          } else {
            const noteIdx = parseInt(step.noteVal, 10);
            const midiNote = notes[noteIdx % notes.length];
            layer.playNote(midiNote, step.velocity, now);
          }
        }
      });

      currentStep = (currentStep + 1) % 16;
      totalElapsedSteps++;

      const bpm = parseFloat(document.getElementById('master-bpm').value);
      const intervalMs = (60 / bpm / 4) * 1000;
      seqTimer = setTimeout(stepSequence, intervalMs);
    }

    // --- Modulation Context Menu ---
    let activeModTargetParamId = null;

    function bindModulationEvents() {
      document.querySelectorAll('.mod-param').forEach(elem => {
        elem.removeEventListener('contextmenu', handleContextMenu);
        elem.addEventListener('contextmenu', handleContextMenu);
      });
    }

    function handleContextMenu(e) {
      e.preventDefault();
      const paramId = e.currentTarget.getAttribute('data-param-id');
      if (!paramId) return;

      activeModTargetParamId = paramId;
      const menu = document.getElementById('mod-menu');
      menu.style.display = 'block';
      menu.style.left = `${e.pageX}px`;
      menu.style.top = `${e.pageY}px`;

      document.getElementById('mod-target-title').textContent = `Mod Target: ${paramId}`;
      updateModSourceOptions();

      const assign = modAssignments[paramId] || { source: 'none', amount: 0 };
      document.getElementById('mod-source-select').value = assign.source;
      document.getElementById('mod-amount-range').value = assign.amount;
    }

    document.getElementById('mod-save-btn').addEventListener('click', () => {
      if (activeModTargetParamId) {
        const src = document.getElementById('mod-source-select').value;
        const amt = parseFloat(document.getElementById('mod-amount-range').value);

        modAssignments[activeModTargetParamId] = { source: src, amount: amt };

        const targetElem = document.querySelector(`[data-param-id="${activeModTargetParamId}"]`);
        if (targetElem) {
          if (src !== 'none') targetElem.classList.add('has-mod');
          else targetElem.classList.remove('has-mod');
        }
      }
      document.getElementById('mod-menu').style.display = 'none';
    });

    document.getElementById('mod-close-btn').addEventListener('click', () => {
      document.getElementById('mod-menu').style.display = 'none';
    });

    // --- Camera Tracking Engine (Downscaled 80x45) ---
    const camVideo = document.getElementById('cam-video');
    const camCanvas = document.getElementById('cam-canvas');
    const camCtx = camCanvas.getContext('2d', { willReadFrequently: true });
    let prevCamFrame = null;
    let isCamRunning = false;

    async function initCameraDevices() {
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const videoDevices = devices.filter(d => d.kind === 'videoinput');
        const select = document.getElementById('cam-select');
        select.innerHTML = '<option value="">Select...</option>';
        videoDevices.forEach((d, idx) => {
          select.innerHTML += `<option value="${d.deviceId}">${d.label || `Cam ${idx+1}`}</option>`;
        });
      } catch (err) {
        console.warn("Camera Enumeration Error:", err);
      }
    }

    async function startCameraStream(deviceId) {
      if (camVideo.srcObject) {
        camVideo.srcObject.getTracks().forEach(t => t.stop());
      }

      const constraints = { video: deviceId ? { deviceId: { exact: deviceId } } : true };

      try {
        const stream = await navigator.mediaDevices.getUserMedia(constraints);
        camVideo.srcObject = stream;
        camVideo.play();
        isCamRunning = true;
        document.getElementById('cam-status').textContent = "Camera: Active";
        document.getElementById('cam-status').style.color = "#2ed573";
        await initCameraDevices();
        requestAnimationFrame(processCameraFrame);
      } catch (err) {
        document.getElementById('cam-status').textContent = "Camera: Blocked/Error";
        document.getElementById('cam-status').style.color = "#ff4757";
        alert("Camera Access Error: " + err.message);
      }
    }

    document.getElementById('btn-start-cam').addEventListener('click', () => {
      startCameraStream(document.getElementById('cam-select').value);
    });

    document.getElementById('cam-select').addEventListener('change', (e) => {
      if (e.target.value) startCameraStream(e.target.value);
    });

    function processCameraFrame() {
      if (!isCamRunning || camVideo.paused || camVideo.ended) return;

      const brightness = parseFloat(document.getElementById('cam-brightness').value);
      const contrast = parseFloat(document.getElementById('cam-contrast').value);

      camCtx.filter = `brightness(${brightness}) contrast(${contrast})`;
      camCtx.drawImage(camVideo, 0, 0, 80, 45);
      
      const frame = camCtx.getImageData(0, 0, 80, 45);
      const data = frame.data;

      if (prevCamFrame && prevCamFrame.length === data.length) {
        let maxDiff = 0, maxX = 0, maxY = 0, totalDiff = 0;

        for (let y = 0; y < 45; y++) {
          for (let x = 0; x < 80; x++) {
            const idx = (y * 80 + x) * 4;
            const diff = Math.abs(data[idx] - prevCamFrame[idx]) +
                         Math.abs(data[idx+1] - prevCamFrame[idx+1]) +
                         Math.abs(data[idx+2] - prevCamFrame[idx+2]);

            totalDiff += diff;
            if (diff > maxDiff) {
              maxDiff = diff;
              maxX = x;
              maxY = y;
            }
          }
        }

        modSources.camX = maxX / 80;
        modSources.camY = 1.0 - (maxY / 45);
        modSources.camMotion = Math.min(totalDiff / (80 * 45 * 80), 1.0);

        document.getElementById('val-cx').textContent = modSources.camX.toFixed(2);
        document.getElementById('val-cy').textContent = modSources.camY.toFixed(2);
        document.getElementById('val-cm').textContent = modSources.camMotion.toFixed(2);
      }

      prevCamFrame = new Uint8Array(data);
      requestAnimationFrame(processCameraFrame);
    }

    // --- Multi-Layered Audio Visualizer Engine & Separate Window System ---
    let vizWindow = null;
    let vizCanvas = null;
    let vizCtx = null;
    let vizParticles = [];

    const btnOpenViz = document.getElementById('btn-open-viz');
    const vizModal = document.getElementById('viz-modal');
    const modalCanvas = document.getElementById('modal-viz-canvas');

    btnOpenViz.addEventListener('click', () => {
      openVisualizerWindow();
    });

    document.getElementById('viz-modal-close').addEventListener('click', () => {
      vizModal.style.display = 'none';
      document.getElementById('val-viz-status').textContent = "Closed";
    });

    function openVisualizerWindow() {
      // Attempt Popout Window
      try {
        vizWindow = window.open("", "SynthVisualizerWindow", "width=1280,height=720,menubar=no,toolbar=no,location=no,status=no");
        if (vizWindow && vizWindow.document) {
          vizWindow.document.write(`
            <!DOCTYPE html>
            <html>
            <head>
              <title>Audio Visualizer - 1920x1080</title>
              <style>
                * { margin:0; padding:0; box-sizing:border-box; background:#000; overflow:hidden; }
                canvas { width:100vw; height:100vh; object-fit:contain; display:block; cursor:crosshair; }
              </style>
            </head>
            <body>
              <canvas id="viz-canvas" width="1920" height="1080"></canvas>
            </body>
            </html>
          `);
          vizWindow.document.close();
          vizCanvas = vizWindow.document.getElementById('viz-canvas');
          vizCtx = vizCanvas.getContext('2d');

          // Sync mouse coordinates from popup window
          vizCanvas.addEventListener('mousemove', (e) => {
            const rect = vizCanvas.getBoundingClientRect();
            modSources.mouseX = (e.clientX - rect.left) / rect.width;
            modSources.mouseY = 1.0 - ((e.clientY - rect.top) / rect.height);
          });

          document.getElementById('val-viz-status').textContent = "Popout Window";
          requestAnimationFrame(renderVisualizerFrame);
          return;
        }
      } catch (err) {
        console.warn("Popout window blocked or failed, falling back to overlay modal:", err);
      }

      // Fallback: Fullscreen Modal Overlay
      vizModal.style.display = 'flex';
      vizCanvas = modalCanvas;
      vizCtx = vizCanvas.getContext('2d');
      document.getElementById('val-viz-status').textContent = "Modal Overlay";

      modalCanvas.addEventListener('mousemove', (e) => {
        const rect = modalCanvas.getBoundingClientRect();
        modSources.mouseX = (e.clientX - rect.left) / rect.width;
        modSources.mouseY = 1.0 - ((e.clientY - rect.top) / rect.height);
      });

      requestAnimationFrame(renderVisualizerFrame);
    }

    // --- Main Visualizer Frame Rendering Function ---
    function renderVisualizerFrame() {
      if (!vizCanvas || !vizCtx) return;

      const W = 1920, H = 1080;
      const cx = W / 2, cy = H / 2;

      // 1. Post-Effect: Delay Echo Persistence
      // Find maximum delay send across layers
      let maxDelaySend = 0;
      vcoLayers.forEach(l => { maxDelaySend = Math.max(maxDelaySend, l.params.sendDelay); });
      const fadeAlpha = Math.max(0.06, 0.45 - (maxDelaySend * 0.38));

      vizCtx.fillStyle = `rgba(13, 15, 23, ${fadeAlpha})`;
      vizCtx.fillRect(0, 0, W, H);

      // 2. Render Mouse Particle Trails
      renderMouseParticles(vizCtx, W, H);

      // 3. Render Each VCO Layer
      vcoLayers.forEach(layer => {
        if (!layer.analyser) return;

        const fftSize = layer.analyser.frequencyBinCount;
        const freqData = new Uint8Array(fftSize);
        const timeData = new Uint8Array(fftSize);

        layer.analyser.getByteFrequencyData(freqData);
        layer.analyser.getByteTimeDomainData(timeData);

        // Calculate average amplitude
        let sumAmp = 0;
        for (let i = 0; i < fftSize; i++) sumAmp += Math.abs(timeData[i] - 128);
        const avgAmp = sumAmp / (fftSize * 128);

        vizCtx.save();

        // --- Post-Effect: Distortion (Screen Shake / Jitter) ---
        if (layer.params.sendDist > 0.05) {
          const shakeMag = layer.params.sendDist * 35 * (avgAmp + 0.1);
          const shakeX = (Math.random() - 0.5) * shakeMag;
          const shakeY = (Math.random() - 0.5) * shakeMag;
          vizCtx.translate(shakeX, shakeY);
        }

        // --- Post-Effect: Reverb (Glow / Blur) ---
        if (layer.params.sendReverb > 0.05) {
          vizCtx.shadowBlur = layer.params.sendReverb * 35;
          vizCtx.shadowColor = layer.params.vizColor;
        } else {
          vizCtx.shadowBlur = 0;
        }

        vizCtx.strokeStyle = layer.params.vizColor;
        vizCtx.fillStyle = layer.params.vizColor;
        vizCtx.lineWidth = layer.params.vizLineWidth;
        vizCtx.lineCap = 'round';
        vizCtx.lineJoin = 'round';

        // --- Shape Rendering Modes ---
        switch (layer.params.vizShape) {
          case 'circular':
            renderCircularOscilloscope(vizCtx, timeData, cx, cy, layer);
            break;

          case 'radial':
            renderRadialWaveform(vizCtx, freqData, cx, cy, layer);
            break;

          case 'band16':
            renderSpectrumBands(vizCtx, freqData, 16, W, H, layer);
            break;

          case 'band128':
            renderSpectrumBands(vizCtx, freqData, 128, W, H, layer);
            break;

          case 'graph':
            renderSpectrumGraph(vizCtx, freqData, W, H, layer);
            break;

          case 'ampCircle':
            renderAmplitudeCircle(vizCtx, avgAmp, cx, cy, layer);
            break;

          case 'cube32x18':
            renderCubeMatrix(vizCtx, freqData, W, H, layer);
            break;
        }

        // --- Post-Effect: Chorus (Glitch / RGB Split Offset) ---
        if (layer.params.sendChorus > 0.1 && Math.random() < layer.params.sendChorus) {
          vizCtx.save();
          const glitchX = (Math.random() - 0.5) * layer.params.sendChorus * 50;
          vizCtx.translate(glitchX, 0);
          vizCtx.strokeStyle = '#00f0ff';
          vizCtx.globalAlpha = 0.6;
          vizCtx.stroke();
          vizCtx.restore();
        }

        vizCtx.restore();
      });

      if (vizWindow && !vizWindow.closed) {
        requestAnimationFrame(renderVisualizerFrame);
      } else if (vizModal.style.display === 'flex') {
        requestAnimationFrame(renderVisualizerFrame);
      } else {
        document.getElementById('val-viz-status').textContent = "Closed";
      }
    }

    // --- Shape Mode 1: Circular Oscilloscope ---
    function renderCircularOscilloscope(ctx, timeData, cx, cy, layer) {
      const len = timeData.length;
      const baseRadius = 260;
      ctx.beginPath();
      for (let i = 0; i < len; i++) {
        const angle = (i / len) * Math.PI * 2;
        const v = (timeData[i] - 128) / 128.0;
        const r = baseRadius + v * 120;
        const x = cx + Math.cos(angle) * r;
        const y = cy + Math.sin(angle) * r;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.closePath();
      ctx.stroke();
    }

    // --- Shape Mode 2: Radial Expanding Waveform ---
    function renderRadialWaveform(ctx, freqData, cx, cy, layer) {
      const len = 64;
      for (let i = 0; i < len; i++) {
        const angle = (i / len) * Math.PI * 2;
        const val = freqData[i] / 255.0;
        const innerR = 60;
        const outerR = innerR + val * 380;

        const x1 = cx + Math.cos(angle) * innerR;
        const y1 = cy + Math.sin(angle) * innerR;
        const x2 = cx + Math.cos(angle) * outerR;
        const y2 = cy + Math.sin(angle) * outerR;

        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      }
    }

    // --- Shape Mode 3 & 4: Band Spectrum Analyzer (16 or 128) ---
    function renderSpectrumBands(ctx, freqData, bandCount, W, H, layer) {
      const barWidth = (W / bandCount) - 4;
      const step = Math.floor(freqData.length / bandCount);

      for (let i = 0; i < bandCount; i++) {
        const val = freqData[i * step] / 255.0;
        const barHeight = val * (H * 0.7);
        const x = i * (barWidth + 4) + 2;
        const y = H - barHeight;

        ctx.fillRect(x, y, barWidth, barHeight);
      }
    }

    // --- Shape Mode 5: Spectrum Graph ---
    function renderSpectrumGraph(ctx, freqData, W, H, layer) {
      const len = freqData.length;
      ctx.beginPath();
      ctx.moveTo(0, H);
      for (let i = 0; i < len; i++) {
        const x = (i / len) * W;
        const y = H - (freqData[i] / 255.0) * (H * 0.8);
        ctx.lineTo(x, y);
      }
      ctx.lineTo(W, H);
      ctx.closePath();
      
      ctx.globalAlpha = 0.25;
      ctx.fill();
      ctx.globalAlpha = 1.0;
      ctx.stroke();
    }

    // --- Shape Mode 6: Amplitude Pulse Circle ---
    function renderAmplitudeCircle(ctx, avgAmp, cx, cy, layer) {
      const radius = 80 + avgAmp * 450;
      ctx.beginPath();
      ctx.arc(cx, cy, radius, 0, Math.PI * 2);
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(cx, cy, radius * 0.6, 0, Math.PI * 2);
      ctx.globalAlpha = 0.2;
      ctx.fill();
      ctx.globalAlpha = 1.0;
    }

    // --- Shape Mode 7: 32x18 Cube Matrix ---
    function renderCubeMatrix(ctx, freqData, W, H, layer) {
      const cols = 32, rows = 18;
      const cellW = W / cols;
      const cellH = H / rows;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const idx = (r * cols + c) % freqData.length;
          const val = freqData[idx] / 255.0;
          if (val < 0.05) continue;

          const cx = c * cellW + cellW / 2;
          const cy = r * cellH + cellH / 2;
          const size = Math.min(cellW, cellH) * val * 0.9;

          ctx.strokeRect(cx - size / 2, cy - size / 2, size, size);
        }
      }
    }

    // --- Mouse Particle System ---
    function renderMouseParticles(ctx, W, H) {
      const mouseX = modSources.mouseX * W;
      const mouseY = (1.0 - modSources.mouseY) * H;
      const speed = modSources.mouseSpeed;

      // Read Modulatable Particle Parameters
      const rawRatio = parseFloat(document.getElementById('particle-ratio-slider').value);
      const modRatio = getModulatedValue('particleRatio', rawRatio, 0.1, 5.0);

      const rawSize = parseFloat(document.getElementById('particle-size-slider').value);
      const modSize = getModulatedValue('particleSize', rawSize, 2, 50);

      const shape = document.getElementById('particle-shape').value;

      // Spawn Particles based on mouse speed & modRatio
      const spawnCount = Math.floor(modRatio * (1 + speed * 4));
      for (let i = 0; i < spawnCount; i++) {
        vizParticles.push({
          x: mouseX + (Math.random() - 0.5) * 15,
          y: mouseY + (Math.random() - 0.5) * 15,
          vx: (Math.random() - 0.5) * (2 + speed * 6),
          vy: (Math.random() - 0.5) * (2 + speed * 6),
          size: modSize * (0.5 + Math.random() * 0.8),
          alpha: 1.0,
          decay: 0.02 + Math.random() * 0.03,
          color: `hsl(${(Date.now() / 10) % 360}, 100%, 70%)`
        });
      }

      // Update & Render Particles
      for (let i = vizParticles.length - 1; i >= 0; i--) {
        const p = vizParticles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.alpha -= p.decay;

        if (p.alpha <= 0) {
          vizParticles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.globalAlpha = p.alpha;
        ctx.fillStyle = p.color;
        ctx.strokeStyle = p.color;
        ctx.lineWidth = 2;

        ctx.beginPath();
        switch (shape) {
          case 'square':
            ctx.fillRect(p.x - p.size / 2, p.y - p.size / 2, p.size, p.size);
            break;

          case 'star':
            drawStar(ctx, p.x, p.y, 5, p.size, p.size / 2);
            ctx.fill();
            break;

          case 'ring':
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.stroke();
            break;

          case 'spark':
            ctx.moveTo(p.x - p.size, p.y); ctx.lineTo(p.x + p.size, p.y);
            ctx.moveTo(p.x, p.y - p.size); ctx.lineTo(p.x, p.y + p.size);
            ctx.stroke();
            break;

          case 'circle':
          default:
            ctx.arc(p.x, p.y, p.size / 2, 0, Math.PI * 2);
            ctx.fill();
            break;
        }
        ctx.restore();
      }
    }

    function drawStar(ctx, cx, cy, spikes, outerRadius, innerRadius) {
      let rot = (Math.PI / 2) * 3;
      let x = cx, y = cy;
      const step = Math.PI / spikes;

      ctx.beginPath();
      ctx.moveTo(cx, cy - outerRadius);
      for (let i = 0; i < spikes; i++) {
        x = cx + Math.cos(rot) * outerRadius;
        y = cy + Math.sin(rot) * outerRadius;
        ctx.lineTo(x, y);
        rot += step;

        x = cx + Math.cos(rot) * innerRadius;
        y = cy + Math.sin(rot) * innerRadius;
        ctx.lineTo(x, y);
        rot += step;
      }
      ctx.lineTo(cx, cy - outerRadius);
      ctx.closePath();
    }

    // --- Save & Load JSON Preset Engine ---
    function getFullState() {
      return {
        presetName: prompt("Enter Preset Name:", "VisualizerSynthPreset") || "VisualizerSynthPreset",
        master: {
          vol: document.getElementById('master-vol').value,
          bpm: document.getElementById('master-bpm').value,
          transpose: document.getElementById('master-transpose').value,
          chordSlider: document.getElementById('chord-slider').value,
          chordRateSlider: document.getElementById('chord-rate-slider').value,
          mouseSens: document.getElementById('mouse-sens').value
        },
        particles: {
          shape: document.getElementById('particle-shape').value,
          ratio: document.getElementById('particle-ratio-slider').value,
          size: document.getElementById('particle-size-slider').value
        },
        fx: {
          distDrive: document.getElementById('fx-dist-drive').value,
          chorusRate: document.getElementById('fx-chorus-rate').value,
          chorusDepth: document.getElementById('fx-chorus-depth').value,
          delayTime: document.getElementById('fx-delay-time').value,
          delayFb: document.getElementById('fx-delay-fb').value,
          verbTime: document.getElementById('fx-verb-time').value
        },
        lfos: lfoList.map(l => ({ id: l.id, type: l.type, mode: l.mode, msPeriod: l.msPeriod, noteRatio: l.noteRatio })),
        vcos: vcoLayers.map(l => ({
          id: l.id,
          params: l.params,
          steps: l.steps
        })),
        modAssignments: modAssignments
      };
    }

    function loadFullState(state) {
      if (!state) return;

      if (state.master) {
        document.getElementById('master-vol').value = state.master.vol || 0.7;
        document.getElementById('master-bpm').value = state.master.bpm || 120;
        document.getElementById('master-transpose').value = state.master.transpose || 0;
        document.getElementById('chord-slider').value = state.master.chordSlider || 0;
        document.getElementById('chord-rate-slider').value = state.master.chordRateSlider || 2;
        document.getElementById('mouse-sens').value = state.master.mouseSens || 1.0;
        document.getElementById('bpm-val').textContent = state.master.bpm || 120;
        document.getElementById('transpose-val').textContent = state.master.transpose || 0;
      }

      if (state.particles) {
        document.getElementById('particle-shape').value = state.particles.shape || 'circle';
        document.getElementById('particle-ratio-slider').value = state.particles.ratio || 1.0;
        document.getElementById('particle-size-slider').value = state.particles.size || 12;
      }

      if (state.fx) {
        document.getElementById('fx-dist-drive').value = state.fx.distDrive || 0;
        document.getElementById('fx-chorus-rate').value = state.fx.chorusRate || 1.5;
        document.getElementById('fx-chorus-depth').value = state.fx.chorusDepth || 0.3;
        document.getElementById('fx-delay-time').value = state.fx.delayTime || 0.3;
        document.getElementById('fx-delay-fb').value = state.fx.delayFb || 0.4;
        document.getElementById('fx-verb-time').value = state.fx.verbTime || 2.0;

        updateDistortionCurve(parseFloat(state.fx.distDrive || 0));
        updateReverbImpulse(parseFloat(state.fx.verbTime || 2.0));
      }

      lfoList = [];
      document.getElementById('lfos-container').innerHTML = '';
      if (state.lfos) {
        state.lfos.forEach(lData => {
          const lfo = new LFO(lData.id);
          lfo.type = lData.type;
          lfo.mode = lData.mode;
          lfo.msPeriod = lData.msPeriod;
          lfo.noteRatio = lData.noteRatio;
          lfoList.push(lfo);
          renderLFOUI(lfo);
        });
        lfoIdCounter = Math.max(...state.lfos.map(l => l.id), 0);
      }

      vcoLayers = [];
      document.getElementById('layers-container').innerHTML = '';
      if (state.vcos) {
        state.vcos.forEach(vData => {
          const layer = new VCOLayer(vData.id, document.getElementById('layers-container'));
          layer.params = vData.params;
          layer.steps = vData.steps;

          const el = layer.element;
          el.querySelector('.wt-pos').value = layer.params.wtPos;
          el.querySelector('.filter-type').value = layer.params.filterType;
          el.querySelector('.filter-cutoff').value = layer.params.cutoff;
          el.querySelector('.filter-reso').value = layer.params.resonance;
          el.querySelector('.env-a').value = layer.params.attack;
          el.querySelector('.env-d').value = layer.params.decay;
          el.querySelector('.env-s').value = layer.params.sustain;
          el.querySelector('.env-r').value = layer.params.release;
          el.querySelector('.send-dist').value = layer.params.sendDist || 0;
          el.querySelector('.send-chorus').value = layer.params.sendChorus || 0;
          el.querySelector('.send-delay').value = layer.params.sendDelay || 0;
          el.querySelector('.send-verb').value = layer.params.sendReverb || 0;

          if (el.querySelector('.viz-color-picker')) el.querySelector('.viz-color-picker').value = layer.params.vizColor || '#00f0ff';
          if (el.querySelector('.viz-shape-select')) el.querySelector('.viz-shape-select').value = layer.params.vizShape || 'circular';
          if (el.querySelector('.viz-line-width')) el.querySelector('.viz-line-width').value = layer.params.vizLineWidth || 3;

          const stepElems = el.querySelectorAll('.seq-step');
          layer.steps.forEach((s, idx) => {
            if (stepElems[idx]) {
              stepElems[idx].querySelector('.seq-active').checked = s.active;
              stepElems[idx].querySelector('.seq-vel').value = s.velocity;
              stepElems[idx].querySelector('.seq-note').value = s.noteVal;
            }
          });

          vcoLayers.push(layer);
        });
        layerIdCounter = Math.max(...state.vcos.map(v => v.id), 0);
      }

      Object.assign(modAssignments, state.modAssignments || {});
      bindModulationEvents();
      updateModSourceOptions();
    }

    document.getElementById('btn-save-json').addEventListener('click', () => {
