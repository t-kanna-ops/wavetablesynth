      playNote(midiNote, velocity, time) {
        if (!audioCtx) return;

        if (!this.analyser) {
          this.analyser = audioCtx.createAnalyser();
          this.analyser.fftSize = 512;
        }

        const wtVal = getModulatedValue(`layer_${this.id}_wtPos`, this.params.wtPos, 0, 1);
        const cutoffVal = getModulatedValue(`layer_${this.id}_cutoff`, this.params.cutoff, 20, 20000);
        const resoVal = getModulatedValue(`layer_${this.id}_resonance`, this.params.resonance, 0.1, 20);

        const osc = audioCtx.createOscillator();
        const wave = createCustomWavetable(audioCtx, wtVal);
        osc.setPeriodicWave(wave);

        const transpose = parseInt(document.getElementById('master-transpose').value);
        const freq = 440 * Math.pow(2, (midiNote + transpose - 69) / 12);
        osc.frequency.setValueAtTime(freq, time);

        const filter = audioCtx.createBiquadFilter();
        filter.type = this.params.filterType;
        filter.frequency.setValueAtTime(cutoffVal, time);
        filter.Q.setValueAtTime(resoVal, time);

        const envGain = audioCtx.createGain();
        const now = time;
        const a = getModulatedValue(`layer_${this.id}_attack`, this.params.attack, 0.001, 2);
        const d = getModulatedValue(`layer_${this.id}_decay`, this.params.decay, 0.01, 2);
        const s = getModulatedValue(`layer_${this.id}_sustain`, this.params.sustain, 0, 1);
        const r = getModulatedValue(`layer_${this.id}_release`, this.params.release, 0.01, 3);

        const peakVol = velocity;
        envGain.gain.setValueAtTime(0, now);
        envGain.gain.linearRampToValueAtTime(peakVol, now + a);
        envGain.gain.linearRampToValueAtTime(peakVol * s, now + a + d);
        envGain.gain.setValueAtTime(peakVol * s, now + a + d + 0.1);
        envGain.gain.exponentialRampToValueAtTime(0.0001, now + a + d + 0.1 + r);

        osc.connect(filter);
        filter.connect(envGain);

        // Connect layer signal to layer's AnalyserNode
        envGain.connect(this.analyser);

        // Connect from Analyser to Master & FX
        this.analyser.connect(masterGain);

        if (this.params.sendDist > 0 && fxDistortion) {
          const g = audioCtx.createGain(); g.gain.value = this.params.sendDist;
          this.analyser.connect(g); g.connect(fxDistortion);
        }
        if (this.params.sendChorus > 0 && fxChorusDelay) {
          const g = audioCtx.createGain(); g.gain.value = this.params.sendChorus;
          this.analyser.connect(g); g.connect(fxChorusDelay);
        }
        if (this.params.sendDelay > 0 && fxDelayL) {
          const g = audioCtx.createGain(); g.gain.value = this.params.sendDelay;
          this.analyser.connect(g); g.connect(fxDelayL);
        }
        if (this.params.sendReverb > 0 && fxReverbConvolver) {
          const g = audioCtx.createGain(); g.gain.value = this.params.sendReverb;
          this.analyser.connect(g); g.connect(fxReverbConvolver);
        }

        osc.start(now);
        osc.stop(now + a + d + 0.1 + r + 0.1);
      }
    }

    // --- Modulation Helper ---
    function getModulatedValue(paramId, baseValue, minVal, maxVal) {
      const assign = modAssignments[paramId];
      if (!assign || assign.source === 'none') return baseValue;

      const srcValue = modSources[assign.source] || 0;
      const modAmount = assign.amount;
      const range = maxVal - minVal;

      let result = baseValue + (srcValue * modAmount * range);
      return Math.max(minVal, Math.min(maxVal, result));
    }

    function updateModSourceOptions() {
      const select = document.getElementById('mod-source-select');
      const currentVal = select.value;
      select.innerHTML = `
        <option value="none">None</option>
